{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "之之桌面宠物",
  "mainBinaryName": "ZhizhiPet",
  "version": "0.1.0",
  "identifier": "com.zhizhi.desktop-pet",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "之之桌面宠物",
        "width": 288,
        "height": 312,
        "minWidth": 230.4,
        "minHeight": 249.6,
        "maxWidth": 360,
        "maxHeight": 390,
        "resizable": false,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "focus": false,
        "center": false
      }
    ],
    "security": {
      "csp": "default-src 'self' customprotocol: asset:; img-src 'self' asset: http://asset.localhost blob: data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Zhizhi's family",
    "category": "Entertainment",
    "shortDescription": "之之的离线 Windows 桌面电子宠物",
    "longDescription": "一只会在桌面底部安静散步、可以拖动和点击互动的之之电子宠物。完全离线运行。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"],
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
